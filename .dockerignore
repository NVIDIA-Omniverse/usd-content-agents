# Git files
.git
.gitignore
.gitattributes

# Build resources (Scene Optimizer Core) are intentionally NOT ignored
# here so they can be COPY'd into the image. See
# scripts/fetch_build_resources.sh. The directory is gitignored via `.*`.
# .build-resources/

# Python cache files
__pycache__
**/__pycache__/
*.py[cod]
*$py.class
*.so
# Re-include the Scene Optimizer Core native libs (`lib/*.so`,
# `extraLibs/*.so*`). Without these overrides the `*.so` rule above strips
# every shared object out of the build context, which would leave
# `.build-resources/scene_optimizer_core/` empty.
!.build-resources/**/*.so
!.build-resources/**/*.so.*
.Python
*.egg-info/
**/*.egg-info/
# dist/
build/
*.egg

# Node.js (avoid copying local web build artifacts into Docker)
node_modules/
apps/material_agent_service/web/dist/

# Env files (secrets). `.env*` covers `.env`, `.env.local`, `.env copy`,
# `.env.production`, etc. — developer backups and local overrides must not
# leak into images. Explicit re-includes for the reference templates that
# are intended to ship in the repo/image.
.env*
**/.env*
!.env_example
!**/.env_example
!.env_example_public
!**/.env_example_public

# Local credentials and package-manager auth files
.aws/
.azure/
.config/gcloud/
.npmrc
.pypirc
.netrc
credentials
credentials.*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519

# Virtual environments
.venv
.venvs/
**/.venv/
env/
venv/
ENV/
env.bak/
venv.bak/
**/env/
**/venv/
**/ENV/
**/env.bak/
**/venv.bak/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Test and coverage files
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
**/.ruff_cache/
**/__pycache__/

# Session data (will be mounted as volume)
apps/material_agent_service/sessions/
apps/joint_agent_service/sessions/
apps/material_agent_service/combined_service_files.py

# Generated artifacts and local external installs
**/output/
.external/


# Documentation
docs/
*.md
!README.md
!VERSION.md
!THIRD_PARTY_NOTICE.md
!apps/usd_cli/README.md
!apps/material_agent_service/README.md
!agentic/packages/sdf_tools/README.md
# The direct OCP build packages reviewed source provenance with each wheel.
!agentic/packages/cad_verifier/README.md
!agentic/packages/geometry_authoring_contracts/README.md
!agentic/packages/geometry_authoring_connectors/README.md
!agentic/packages/geometry_repair/README.md
!apps/geometry_agent_service/README.md
!apps/physics_agent/README.md
!apps/texture_agent/README.md
!apps/texture_gen_service_common/README.md
# Native builds copy these reviewed legal notices into images and wheels.
!agentic/packages/openvdb_runtime/native/SOURCE_PROVENANCE.md
!agentic/packages/openvdb_runtime/native/THIRD_PARTY_NOTICES.md
!agentic/packages/geometry_repair/geometry_repair/GEOGRAM_THIRD_PARTY_NOTICES.md
!agentic/packages/geometry_repair/geometry_repair/DEPENDENCY_AUDIT.md

# Notebooks
*.ipynb
notebooks/

# Large test files
test_data/
examples/

# Docker files from build
apps/material_agent_service/Dockerfile
apps/material_agent_service/docker-compose.yml
apps/*_agent_service/Dockerfile
apps/*_agent_service/Dockerfile.ci
apps/*_agent_service/docker-compose*.yml
apps/*_agent_service/internal/Dockerfile*
apps/*_agent_service/internal/docker-compose*.yml

# Log files
*.log
logs/

# Temporary files
*.tmp
*.bak
*.backup
tmp/
temp/

# OS files
Thumbs.db
Desktop.ini
.Trash-*
