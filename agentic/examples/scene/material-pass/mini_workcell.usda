#usda 1.0
(
    defaultPrim = "Workcell"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Workcell" (
    kind = "assembly"
)
{
    def Xform "Workbench" (
        prepend references = @simready-foundation/sample_content/common_assets/props_general/obs_workbench_tool_a01/simready_usd/sm_obs_workbench_tool_a01_01.usd@
    )
    {
    }

    def Xform "Toolbox" (
        prepend references = @simready-foundation/sample_content/common_assets/props_general/obs_electricians_large_tool_box_a01/simready_usd/sm_obs_electricians_large_tool_box_a01_01.usd@
    )
    {
        double3 xformOp:translate = (-0.5, 0, 0.91)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Sledgehammer" (
        prepend references = @simready-foundation/sample_content/common_assets/props_general/obs_small_sledge_hammer_a01/simready_usd/sm_obs_small_sledge_hammer_a01_01.usd@
    )
    {
        double xformOp:rotateZ = -20
        double3 xformOp:translate = (0.48, 0, 0.92)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]
    }
}
