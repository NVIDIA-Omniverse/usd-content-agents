    {
      "id": "glibc",
      "relationship": "platform_abi",
      "license": "LGPL-2.1-or-later",
      "must_be_external": true,
      "required": true,
      "rationale": "The pre-existing manylinux CPython/Linux ABI; never bundled by this SDF driver wheel",
      "provider_packages": [
        "libc6"
      ],
      "soname_patterns": [
        "^libc[.]so[.]6$",
        "^libm[.]so[.]6$",
        "^libpthread[.]so[.]0$",
        "^libdl[.]so[.]2$",
        "^librt[.]so[.]1$",
        "^libutil[.]so[.]1$",
        "^libresolv[.]so[.]2$",
        "^ld-linux-x86-64[.]so[.]2$",
        "^ld-linux-aarch64[.]so[.]1$"
      ]
    },
    {
      "id": "gcc-runtime",
      "relationship": "platform_abi",
      "license": "GPL-3.0-or-later WITH GCC-exception-3.1",
      "must_be_external": true,
      "required": true,
      "rationale": "The pre-existing C++ compiler runtime ABI; never bundled by this SDF driver wheel",
      "provider_packages": [
        "libgcc-s1",
        "libstdc++6"
      ],
      "soname_patterns": [
        "^libgcc_s[.]so[.]1$",
        "^libstdc[+][+][.]so[.]6$"
      ]
