#usda 1.0
(
    "Material Library for cube. "
    customLayerData = {
        string creator = "GTC26 OBJ to USD Converter"
    }
    defaultPrim = "Materials"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

class Scope "Materials"
{
    def Material "red" (
        instanceable = true
    )
    {
        color3f inputs:diffuseColor = (1, 0, 0)
        float inputs:ior = 1
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0
        token inputs:wrapMode = "repeat"
        token outputs:displacement.connect = </Materials/red/PreviewSurface.outputs:displacement>
        token outputs:surface.connect = </Materials/red/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Materials/red.inputs:diffuseColor>
            float inputs:ior.connect = </Materials/red.inputs:ior>
            float inputs:metallic.connect = </Materials/red.inputs:metallic>
            float inputs:opacity.connect = </Materials/red.inputs:opacity>
            float inputs:roughness.connect = </Materials/red.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }
    }

