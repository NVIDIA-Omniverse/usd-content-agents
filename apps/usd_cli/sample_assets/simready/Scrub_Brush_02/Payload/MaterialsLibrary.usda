        float inputs:opacity = 1
        float inputs:roughness = 1
        token inputs:wrapMode = "repeat"
        token outputs:displacement.connect = </Materials/opaque__sponge__orange_01/PreviewSurface.outputs:displacement>
        token outputs:surface.connect = </Materials/opaque__sponge__orange_01/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Materials/opaque__sponge__orange_01/DiffuseTexture.outputs:rgb>
            float inputs:ior.connect = </Materials/opaque__sponge__orange_01.inputs:ior>
            float inputs:metallic.connect = </Materials/opaque__sponge__orange_01.inputs:metallic>
            float inputs:opacity.connect = </Materials/opaque__sponge__orange_01.inputs:opacity>
            float inputs:roughness.connect = </Materials/opaque__sponge__orange_01.inputs:roughness>
            token outputs:displacement
            token outputs:surface
        }

        def Shader "DiffuseTexture"
        {
            uniform token info:id = "UsdUVTexture"
            float4 inputs:fallback = (0.31854683, 0.31854683, 0.31854683, 1)
            asset inputs:file.connect = </Materials/opaque__sponge__orange_01.inputs:DiffuseTexture>
            token inputs:sourceColorSpace = "auto"
            float2 inputs:st.connect = </Materials/opaque__sponge__orange_01/Primvar_st_float2.outputs:result>
            token inputs:wrapS.connect = </Materials/opaque__sponge__orange_01.inputs:wrapMode>
            token inputs:wrapT.connect = </Materials/opaque__sponge__orange_01.inputs:wrapMode>
            float3 outputs:rgb
        }

        def Shader "Primvar_st_float2"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }
    }
}
