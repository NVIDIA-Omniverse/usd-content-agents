#usda 1.0
(
    "Material Library for spraygun2. "
    customLayerData = {
        string creator = "GTC26 OBJ to USD Converter"
    }
    defaultPrim = "Materials"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

class Scope "Materials"
{
    def Material "aluminum" (
        instanceable = true
    )
    {
        asset inputs:DiffuseTexture = @./Textures/T_paint_supplies_spraygun_albedo.png@
        float inputs:ior = 1.5
        asset inputs:MetallicTexture = @./Textures/T_paint_supplies_spraygun_metal.png@
        float inputs:opacity = 1
        asset inputs:RoughnessTexture = @./Textures/T_paint_supplies_spraygun_rough.png@
        token inputs:wrapMode = "repeat"
        token outputs:displacement.connect = </Materials/aluminum/PreviewSurface.outputs:displacement>
        token outputs:surface.connect = </Materials/aluminum/PreviewSurface.outputs:surface>

        def Shader "PreviewSurface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor.connect = </Materials/aluminum/DiffuseTexture.outputs:rgb>
            float inputs:ior.connect = </Materials/aluminum.inputs:ior>
            float inputs:metallic.connect = </Materials/aluminum/MetallicTexture.outputs:r>
            float inputs:opacity.connect = </Materials/aluminum.inputs:opacity>
            float inputs:roughness.connect = </Materials/aluminum/RoughnessTexture.outputs:r>
            token outputs:displacement
            token outputs:surface
        }

        def Shader "DiffuseTexture"
        {
            uniform token info:id = "UsdUVTexture"
            float4 inputs:fallback = (0.31854683, 0.31854683, 0.31854683, 1)
            asset inputs:file.connect = </Materials/aluminum.inputs:DiffuseTexture>
            token inputs:sourceColorSpace = "auto"
            float2 inputs:st.connect = </Materials/aluminum/Primvar_st_float2.outputs:result>
            token inputs:wrapS.connect = </Materials/aluminum.inputs:wrapMode>
            token inputs:wrapT.connect = </Materials/aluminum.inputs:wrapMode>
            float3 outputs:rgb
        }

        def Shader "Primvar_st_float2"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            string inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "MetallicTexture"
        {
            uniform token info:id = "UsdUVTexture"
            float4 inputs:fallback = (0, 0, 0, 1)
            asset inputs:file.connect = </Materials/aluminum.inputs:MetallicTexture>
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Materials/aluminum/Primvar_st_float2.outputs:result>
            token inputs:wrapS.connect = </Materials/aluminum.inputs:wrapMode>
            token inputs:wrapT.connect = </Materials/aluminum.inputs:wrapMode>
            float outputs:r
        }

        def Shader "RoughnessTexture"
        {
            uniform token info:id = "UsdUVTexture"
            float4 inputs:fallback = (0, 0, 0, 1)
            asset inputs:file.connect = </Materials/aluminum.inputs:RoughnessTexture>
            token inputs:sourceColorSpace = "raw"
            float2 inputs:st.connect = </Materials/aluminum/Primvar_st_float2.outputs:result>
            token inputs:wrapS.connect = </Materials/aluminum.inputs:wrapMode>
            token inputs:wrapT.connect = </Materials/aluminum.inputs:wrapMode>
            float outputs:r
        }
    }

