    def Material "tn__Surface__Matte001_hPY0" (
        displayName = "Surface_-_Matte.001"
        instanceable = true
    )
    {
        color3f inputs:diffuseColor = (0.4507861, 0.4507861, 0.4507861)
        float inputs:ior = 1
        float inputs:metallic = 0
        float inputs:opacity = 1
        float inputs:roughness = 0
        token inputs:wrapMode = "repeat"
        token outputs:displacement.connect = </Materials/tn__Surface__Matte001_hPY0/PreviewSurface.outputs:displacement>
        token outputs:surface.connect = </Materials/tn__Surface__Matte001_hPY0/PreviewSurface.outputs:surface>

