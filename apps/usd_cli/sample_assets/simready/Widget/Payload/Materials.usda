#usda 1.0
(
    customLayerData = {
        string creator = "GTC26 OBJ to USD Converter"
    }
    defaultPrim = "widget"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "widget"
{
    def Scope "Materials"
    {
        def Material "PVC_X" (
            prepend references = @./MaterialsLibrary.usda@</Materials/PVC_X>
        )
        {
        }

        def Material "PVC_Y" (
            prepend references = @./MaterialsLibrary.usda@</Materials/PVC_Y>
        )
        {
        }

        def Material "PVC_Z" (
            prepend references = @./MaterialsLibrary.usda@</Materials/PVC_Z>
        )
        {
        }

        def Material "tn__SemiGloss_Plastic_dP" (
            prepend references = @./MaterialsLibrary.usda@</Materials/tn__SemiGloss_Plastic_dP>
        )
        {
        }
    }

    over "Geometry"
    {
        over "arm_obj_x" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </widget/Materials/PVC_X>
        }

        over "arm_obj_y" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </widget/Materials/PVC_Y>
        }

        over "arm_obj_z" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </widget/Materials/PVC_Z>
        }

        over "body" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding = </widget/Materials/tn__SemiGloss_Plastic_dP>
        }
    }
}
