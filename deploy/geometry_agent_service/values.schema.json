{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {"type": "object"},
    "imagePullSecrets": {"type": "array"},
    "nameOverride": {"type": "string"},
    "fullnameOverride": {"type": "string"},
    "existingApiKeySecretName": {"type": "string"},
    "apiKey": {"type": "string"},
    "service": {"type": "object"},
    "ingress": {"type": "object"},
    "workspace": {"type": "object"},
    "render": {
      "type": "object",
      "properties": {
        "backend": {"type": "string", "enum": ["ovrtx", "remote"]},
        "remoteBaseUrl": {"type": "string"},
        "existingApiKeySecretName": {"type": "string"},
        "apiKeySecretKey": {"type": "string"},
        "allowUnauthenticatedIdentity": {"type": "boolean"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultEngine": {
          "type": "string",
          "enum": ["none", "fake", "ovphysx"]
        }
      },
      "required": ["defaultEngine"]
    },
    "delegatedAuthoring": {"type": "object"},
    "build123d": {"type": "object"},
    "forgecadAuthoring": {
      "type": "object",
      "properties": {
        "readTimeoutSeconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 900
        }
      }
    },
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "podSecurityContext": {"type": "object"},
    "containerSecurityContext": {"type": "object"},
    "resources": {"type": "object"}
  }
}
